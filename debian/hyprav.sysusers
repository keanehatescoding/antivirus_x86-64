# systemd-sysusers declaration for the hyprav trusted-reader group
# (see #143) and the unprivileged scan-worker user (#103). Installed by dh_installsysusers (enabled via the
# dh-sequence-installsysusers Build-Depends in debian/control), which
# also generates the postinst snippet that runs systemd-sysusers on
# install - so the group exists before the modprobe.d hook ever
# needs it, even on a fresh install where the module loads before
# any boot-time sysusers pass.
#
# Content twin of packaging/hyprav.sysusers (shipped to
# /usr/lib/sysusers.d by the Arch and Fedora packaging) - both declare
# the same two lines, keep them in sync. A Debian-side copy is
# needed because dh_installsysusers only acts on debian/<pkg>.sysusers.
g hyprav - -
#
# hyprav-scan: the user avd's scan workers drop to when AVD_PRIVSEP=1
# (docs/privilege-separation.md). See packaging/hyprav.sysusers.
u hyprav-scan - "HyprAV scan worker (avd privilege separation)" - /usr/sbin/nologin
