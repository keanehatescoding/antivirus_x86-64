#!/bin/sh
# SPDX-License-Identifier: MIT
#
# av-gui launcher - sets PYTHONPATH to wherever the av_gui package
# actually lives and execs the module.
#
# @LIBDIR@ is a template placeholder (same convention as
# packaging/avd.service's @BINDIR@/@SYSCONFDIR@ and
# packaging/org.hyprav.avctl.policy's @BINDIR@), rendered by this
# directory's Makefile install target via sed - this file as checked
# in is a template, not something a shell can run directly once
# installed.
#
# Also works UNINSTALLED, run straight from a git checkout
# (./bin/av-gui) - if the placeholder was never substituted, fall back
# to resolving av_gui/ relative to this script's own location, same as
# every other component in this repo being buildable/runnable in place
# without `make install` first (see the top-level README).
#
# The unsubstituted-check below is deliberately NOT
# `[ "$LIBDIR" = "@LIBDIR@" ]` - the Makefile's install target runs
# `sed 's|@LIBDIR@|...|g'` over this whole file, which would rewrite
# BOTH the assignment below AND that literal comparison string,
# making it compare a real path against itself and always take the
# fallback branch even when installed. The `@*@` glob matches the
# literal unsubstituted token without spelling out `@LIBDIR@` again,
# so sed has nothing else to rewrite.
LIBDIR="@LIBDIR@"
case "$LIBDIR" in
    @*@) LIBDIR="$(cd "$(dirname "$0")/.." && pwd)" ;;
esac

# @BINDIR@ is the same $(PREFIX)/bin this script itself was installed
# into (see data/av-gui.desktop's Exec= for the same substitution) -
# avctl is installed to that same PREFIX by convention (debian/rules
# passes the identical PREFIX to both components' install targets), so
# this is how pkexec_helper.py learns the real AVCTL_PATH instead of
# relying on its own hardcoded fallback, which only matches a default
# PREFIX=/usr/local install. Left unset when run uninstalled (the
# @BINDIR@ placeholder was never substituted) - pkexec wouldn't find
# an installed policy to authorize against in that case anyway.
BINDIR="@BINDIR@"
case "$BINDIR" in
    @*@) BINDIR="" ;;
esac
if [ -n "$BINDIR" ]; then
    AVCTL_PATH="$BINDIR/avctl"
    export AVCTL_PATH
fi

PYTHONPATH="$LIBDIR${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m av_gui.app "$@"
