#!/usr/bin/env bash
#
# .githooks/pre-push - runs the full build+load+detect+unload test suite
# before anything leaves your machine, but ONLY when the push actually
# touches av/, userspace/avctl/, userspace/avd/, userspace/av-gui/,
# rules/, corpus/, or packaging/ - a docs-only push shouldn't insmod
# a kernel module.
#
# This needs root (insmod/rmmod) and should only run inside your VM.
# Runs via pkexec rather than sudo: pkexec goes through the system's
# polkit authentication agent instead of demanding an interactive
# terminal for a password/fingerprint prompt, so it also works from
# non-interactive/agent-driven shells that can't satisfy sudo's prompt.
#
# Enable with: scripts/setup-hooks.sh   (or: git config core.hooksPath .githooks)
# Bypass once with: git push --no-verify (not recommended, especially
# right before tagging a release)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
CHANGED_FILES=""

# git feeds pre-push one line per ref being pushed, on stdin:
#   <local ref> <local sha1> <remote ref> <remote sha1>
while read -r _ local_sha _ remote_sha; do
    if [ "$local_sha" = "$ZERO_SHA" ]; then
        continue  # deleting a remote ref - nothing to test
    fi
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # New branch/tag on the remote. git diff-tree on a single commit
        # only shows that ONE commit's own changes, not the full range
        # being introduced - on a multi-commit new branch this silently
        # missed every commit but the tip, which could let an av/avctl/
        # avd change reach GitHub with the test suite never having run.
        # Diff against the merge-base with the default branch instead,
        # so every commit on the new branch is actually inspected.
        base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)"
        if [ -z "$base" ]; then
            base="$(git merge-base "$local_sha" origin/master 2>/dev/null)"
        fi
        if [ -n "$base" ]; then
            files="$(git diff --name-only "$base" "$local_sha")"
        else
            # No usable base found (e.g. pushing to a remote with no
            # default/master branch yet). git diff-tree on a single
            # commit has the same "only the tip commit's own delta"
            # problem this whole branch fixed - list every file that
            # actually exists in the resulting tree instead (not a
            # diff at all), so an av/avctl/avd file already present at
            # local_sha is never missed regardless of how many commits
            # got it there.
            files="$(git ls-tree -r --name-only "$local_sha")"
        fi
    else
        files="$(git diff --name-only "$remote_sha" "$local_sha")"
    fi
    CHANGED_FILES="$CHANGED_FILES
$files"
done

# A herestring, not `printf ... | grep -qE ...`: with `pipefail` set
# above, grep -qE's early exit on the first match closes its stdin
# pipe while printf may still be writing later lines, so printf can
# get killed by SIGPIPE - and pipefail then reports THAT (non-zero,
# from printf) as the pipeline's exit status instead of grep's actual
# match result, so a real match could be misreported as "no match"
# and the test suite silently skipped. A herestring has no second
# process and no pipe to close early, so this can't happen.
if ! grep -qE '^(av/|userspace/avctl/|userspace/avd/|userspace/av-gui/|rules/|corpus/|packaging/)' <<< "$CHANGED_FILES"; then
    echo "pre-push: no changes under av/, userspace/avctl/, userspace/avd/, userspace/av-gui/, rules/, corpus/, or packaging/ - skipping test suite"
    exit 0
fi

echo "==> pre-push: changes detected in av/, userspace/avctl/, userspace/avd/, userspace/av-gui/, rules/, corpus/, or packaging/"
echo "    running full test suite (build, insmod, EICAR detection, rmmod)"

# No separate preflight credential check: 'pkexec tests/run_all.sh'
# fails on its own, with its own clear error (and no polkit agent
# available shows up as pkexec exiting nonzero immediately), if
# authentication genuinely can't happen - no need to duplicate that
# check. pkexec wants an absolute path to the program it runs, unlike
# sudo, which resolves relative paths against the caller's cwd.
if pkexec "$REPO_ROOT/tests/run_all.sh"; then
    echo "pre-push: all tests passed"
    exit 0
else
    echo
    echo "pre-push: tests FAILED - push aborted."
    echo "Fix the issue, or bypass with:"
    echo "  git push --no-verify   (not recommended, especially before a tag)"
    exit 1
fi
