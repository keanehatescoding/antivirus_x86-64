#!/usr/bin/env bash
#
# .githooks/pre-commit - fast lint checks on staged files.
# Kept deliberately quick (no build, no insmod) so it doesn't discourage
# committing. The full test suite runs at push time instead - see
# .githooks/pre-push.
#
# Enable with: scripts/setup-hooks.sh   (or: git config core.hooksPath .githooks)
# Bypass once with: git commit --no-verify (not recommended)

set -uo pipefail

FAIL=0
# -z + mapfile -d '' (not plain $(...) word-splitting) so a staged
# filename containing a space or newline still becomes exactly one
# array element instead of being split into several bogus paths.
mapfile -d '' -t STAGED < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED[@]}" -eq 0 ]; then
    exit 0
fi

echo "==> pre-commit: linting staged files"

for f in "${STAGED[@]}"; do
    [ -f "$f" ] || continue

    case "$f" in
        av/*.c|av/*.h)
            if command -v cppcheck >/dev/null 2>&1; then
                echo "  - cppcheck: $f"
                cppcheck --quiet --enable=warning,style,performance \
                    --suppress=missingIncludeSystem --inline-suppr \
                    --error-exitcode=1 "$f" || FAIL=1
            else
                echo "  ! cppcheck not installed - skipping static analysis for $f"
                echo "    (sudo pacman -S cppcheck  /  apt install cppcheck)"
            fi
            # Optional stricter kernel style check, only if you point
            # CHECKPATCH at a full kernel source tree's scripts/checkpatch.pl
            # (not included in headers-only packages, so this is opt-in).
            if [ -n "${CHECKPATCH:-}" ] && [ -x "${CHECKPATCH:-}" ]; then
                echo "  - checkpatch.pl: $f"
                "$CHECKPATCH" --no-tree --terse -f "$f" || FAIL=1
            fi
            ;;
        userspace/avctl/*.c)
            echo "  - gcc -fsyntax-only: $f"
            gcc -fsyntax-only -Wall -Wextra "$f" || FAIL=1
            if command -v cppcheck >/dev/null 2>&1; then
                echo "  - cppcheck: $f"
                cppcheck --quiet --enable=warning,style --inline-suppr \
                    --error-exitcode=1 "$f" || FAIL=1
            fi
            ;;
        userspace/avd/*.c)
            NL_LIBS="$(pkg-config --libs libnl-genl-3.0 2>/dev/null)"
            YARA_LIBS="$(pkg-config --libs yara 2>/dev/null)"
            if [ -z "$NL_LIBS" ] || [ -z "$YARA_LIBS" ]; then
                echo "  ! libnl-genl-3.0 and/or yara not found via pkg-config - skipping syntax check for $f"
                echo "    (sudo pacman -S libnl yara ssdeep  /  apt install libnl-genl-3-dev libyara-dev libfuzzy-dev)"
            else
                echo "  - gcc -fsyntax-only: $f"
                # Arrays, not a plain word-split string - avoids any risk
                # of an empty CFLAGS token reaching gcc as a bogus
                # positional argument (which is what "linker input file
                # not found: No such file or directory" with an empty
                # filename means).
                read -r -a NL_CFLAGS_ARR <<< "$(pkg-config --cflags libnl-genl-3.0 2>/dev/null)"
                read -r -a YARA_CFLAGS_ARR <<< "$(pkg-config --cflags yara 2>/dev/null)"
                if ! gcc -fsyntax-only -Wall -Wextra \
                        "${NL_CFLAGS_ARR[@]}" "${YARA_CFLAGS_ARR[@]}" "$f"; then
                    echo "  ! gcc invocation was:"
                    echo "    gcc -fsyntax-only -Wall -Wextra ${NL_CFLAGS_ARR[*]} ${YARA_CFLAGS_ARR[*]} $f"
                    FAIL=1
                fi
            fi
            ;;
        corpus/*.txt)
            echo "  - corpus format check: $f (non-comment, non-blank lines must contain a comma)"
            # ^[[:space:]]*(#.*)?$ - not ^(#.*)?$: the old pattern missed
            # whitespace-only lines and indented comments ("   # ..."),
            # misclassifying them as data lines.
            if grep -vE '^[[:space:]]*(#.*)?$' "$f" | grep -v ',' | grep -q .; then
                echo "  ! malformed line(s) in $f (missing comma separator)"
                FAIL=1
            fi
            ;;
        rules/*.yar|rules/*.yara|tests/fixtures/*.yar|tests/fixtures/*.yara)
            if command -v yara >/dev/null 2>&1; then
                echo "  - yara --compiled-rules check: $f"
                # `yara <rules> <target>` requires a scan target even to
                # just validate compilation - /bin/true is a harmless
                # always-present stand-in file.
                yara "$f" /bin/true >/dev/null || FAIL=1
                # Weight lint (#99): every non-private rule must declare
                # an integer `weight` meta in 1..100 - avd sums weights
                # toward MALICIOUS_SCORE_THRESHOLD, so a missing weight
                # silently contributes 0 while an out-of-range one can
                # convict alone or never. Private rules are exempt: YARA
                # never reports them, so avd never scores them. Only a
                # real `weight = N` line inside the rule's `meta:`
                # section counts - `weight` inside a comment or a
                # description string must not satisfy the check.
                echo "  - yara weight-meta check: $f"
                if ! awk '
                    {
                        line = $0
                        # Drop inline /* ... */ segments first (greedy:
                        # first opener through last closer on the line).
                        while (match(line, /\/\*.*\*\//)) {
                            line = substr(line, 1, RSTART - 1) substr(line, RSTART + RLENGTH)
                        }
                        # Track multi-line /* ... */ comments: skip the
                        # commented span, keep any code after its end.
                        if (IN_BLOCK) {
                            if (match(line, /\*\//)) {
                                line = substr(line, RSTART + RLENGTH)
                                IN_BLOCK = 0
                            } else {
                                next
                            }
                        }
                        if (match(line, /\/\*/)) {
                            line = substr(line, 1, RSTART - 1)
                            IN_BLOCK = 1
                        }
                        # Drop // comments. Best effort around strings
                        # containing // (e.g. URLs): stripping can only
                        # remove text, and the anchored weight match
                        # below cannot be created by removal.
                        sub(/\/\/.*$/, "", line)
                    }
                    line ~ /^[[:space:]]*(private[[:space:]]+)?rule[[:space:]]+/ {
                        if (NR_RULE != "") {
                            if (!IS_PRIVATE && (!HAS_WEIGHT || WEIGHT < 1 || WEIGHT > 100)) {
                                printf "  ! rule %s in %s: missing or out-of-range weight meta (want 1..100)\n", NR_RULE, FILENAME > "/dev/stderr"
                                BAD = 1
                            }
                        }
                        IS_PRIVATE = (line ~ /^[[:space:]]*private[[:space:]]+rule/)
                        NR_RULE = line; sub(/^.*rule[[:space:]]+/, "", NR_RULE); sub(/[^A-Za-z0-9_].*$/, "", NR_RULE)
                        HAS_WEIGHT = 0; WEIGHT = 0; IN_META = 0
                        next
                    }
                    line ~ /^[[:space:]]*meta[[:space:]]*:/ { IN_META = 1; next }
                    line ~ /^[[:space:]]*(strings|condition)[[:space:]]*:/ { IN_META = 0; next }
                    IN_META && HAS_WEIGHT == 0 && line ~ /^[[:space:]]*weight[[:space:]]*=[[:space:]]*[0-9]+/ {
                        W = line; sub(/^[^=]*=[[:space:]]*/, "", W); sub(/[^0-9].*$/, "", W)
                        HAS_WEIGHT = 1; WEIGHT = W + 0
                    }
                    END {
                        if (NR_RULE != "" && !IS_PRIVATE && (!HAS_WEIGHT || WEIGHT < 1 || WEIGHT > 100)) {
                            printf "  ! rule %s in %s: missing or out-of-range weight meta (want 1..100)\n", NR_RULE, FILENAME > "/dev/stderr"
                            BAD = 1
                        }
                        exit (BAD ? 1 : 0)
                    }
                ' "$f"; then
                    FAIL=1
                fi
            else
                echo "  ! yara CLI not installed - skipping rule syntax check for $f"
                echo "    (sudo pacman -S yara  /  apt install yara)"
            fi
            ;;
        tests/*.sh|.githooks/*)
            if command -v shellcheck >/dev/null 2>&1; then
                echo "  - shellcheck: $f"
                shellcheck "$f" || FAIL=1
            else
                echo "  - bash -n (shellcheck not installed): $f"
                bash -n "$f" || FAIL=1
            fi
            ;;
        *.yml|*.yaml)
            if command -v yamllint >/dev/null 2>&1; then
                echo "  - yamllint: $f"
                yamllint "$f" || FAIL=1
            fi
            ;;
    esac
done

if [ "$FAIL" -ne 0 ]; then
    echo
    echo "pre-commit: lint failed - fix the issues above, or bypass with"
    echo "  git commit --no-verify   (not recommended)"
    exit 1
fi

echo "pre-commit: lint passed"
exit 0
